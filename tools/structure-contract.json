{
  "directories": {
    "assets": ["runtime", "source"],
    "assets/runtime": ["audio"],
    "src": ["app", "core", "entities", "systems", "world", "rendering", "ui", "components"],
    "data": ["animations", "characters", "enemies", "maps"]
  },
  "runtimeAssetPatterns": [
    "^assets/runtime/audio/(music|sfx)/[a-z0-9-]+\\.(mp3|ogg|wav)$",
    "^assets/runtime/audio/(CREDITS\\.md|[A-Za-z0-9-]+-LICENSE\\.txt)$"
  ],
  "forbiddenReferences": [
    "assets/audio/",
    "assets/ui/",
    "assets/runtime/lutetia/",
    "characters/frames/",
    "achivements"
  ],
  "referenceRoots": ["src", "data"],
  "referenceFiles": ["index.html", "opponents-preview.html", "arena-preview.html"],
  "forbiddenIdentifiers": [
    "Villagers",
    "Legion",
    "depthObjects",
    "drawObject",
    "civilian",
    "campLanes"
  ]
}
