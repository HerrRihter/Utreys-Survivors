{
  "directories": {
    "assets": ["runtime", "source"],
    "assets/runtime": ["characters", "world", "projectiles", "effects", "ui", "audio"],
    "assets/runtime/characters": ["heroes", "enemies", "civilians"],
    "assets/runtime/world": ["village", "lutetia", "scenery"],
    "src": ["app", "core", "entities", "systems", "world", "rendering", "ui", "pages"],
    "data": ["animations", "characters", "enemies", "projectiles", "maps"],
    "runtime": ["src", "previews"]
  },
  "runtimeAssetPatterns": [
    "^assets/runtime/characters/(heroes|enemies|civilians)/[a-z0-9-]+/(animations/(idle|walk|attack|hurt|death)/[0-9]+|animations/[a-z0-9-]+|[a-z0-9-]+)\\.png$",
    "^assets/runtime/world/(village|lutetia|scenery)/[a-z0-9-]+\\.png$",
    "^assets/runtime/(projectiles|effects)/[a-z0-9-]+\\.png$",
    "^assets/runtime/ui/([a-z0-9-]+|achievements/[a-z0-9-]+)\\.png$",
    "^assets/runtime/audio/(music|sfx)/[a-z0-9-]+\\.(mp3|ogg|wav)$",
    "^assets/runtime/audio/(CREDITS\\.md|[A-Za-z0-9-]+-LICENSE\\.txt)$"
  ],
  "framePattern": "^characters/(heroes|enemies|civilians)/([a-z0-9-]+)/animations/(idle|walk|attack|hurt|death)/[0-9]+\\.png$",
  "forbiddenReferences": ["assets/audio/", "assets/ui/", "assets/runtime/lutetia/", "characters/frames/", "achivements"],
  "referenceRoots": ["src", "data", "previews", "runtime"],
  "referenceFiles": ["index.html", "opponents-preview.html", "village-preview.html"]
}
