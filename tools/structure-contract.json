{
  "directories": {
    "assets": ["runtime", "source"],
    "assets/runtime": ["audio"],
    "src": ["app", "core", "systems", "world", "rendering", "ui", "components", "services"],
    "data": ["animations", "characters", "enemies", "maps"]
  },
  "layers": {
    "$comment": "Allowed imports between layers: a file in src/<layer> (or data) may import only the listed layers and itself. \"systems/queries\" admits only src/systems/queries, whose pure read-only questions may themselves import only data, core and world. A layer always reaches its own sublayers. \"src\" is the entry files directly in src/. Order: data → core → world → systems → services → rendering → ui → app → components → src. See docs/STRUCTURE-CONTRACT.md.",
    "data": [],
    "core": ["data"],
    "world": ["data", "core"],
    "systems": ["data", "core", "world"],
    "services": ["data", "core", "systems"],
    "systems/queries": ["data", "core", "world"],
    "rendering": ["data", "core", "world", "systems/queries"],
    "ui": ["data", "core", "world", "systems", "rendering"],
    "app": ["data", "core", "world", "systems", "services", "rendering", "ui"],
    "components": ["data", "core", "world", "systems", "services", "rendering", "ui", "app"],
    "src": ["data", "core", "world", "systems", "services", "rendering", "ui", "app", "components"]
  },
  "runtimeAssetPatterns": [
    "^assets/runtime/audio/(music|sfx)/[a-z0-9-]+\\.(mp3|ogg|wav)$",
    "^assets/runtime/audio/(CREDITS\\.md|[A-Za-z0-9-]+-LICENSE\\.txt)$"
  ],
  "forbiddenReferences": [
    "assets/audio/",
    "assets/ui/",
    "assets/runtime/lutetia/",
    "characters/frames/",
    "achivements"
  ],
  "referenceRoots": ["src", "data"],
  "referenceFiles": ["index.html", "opponents-preview.html", "arena-preview.html"],
  "forbiddenIdentifiers": [
    "Villagers",
    "Legion",
    "depthObjects",
    "drawObject",
    "civilian",
    "campLanes"
  ]
}
