{
  "name": "utreys-survivors",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src data tools tests && npm run typecheck",
    "format": "prettier --write src data styles tools tests vite.config.ts",
    "format:check": "prettier --check src data styles tools tests vite.config.ts",
    "test": "node tools/test-all.cjs",
    "test:browser": "node tools/smoke-browser.cjs",
    "test:layout": "node tools/layout-check.cjs",
    "check:structure": "node tools/check-structure.cjs",
    "check:contracts": "node tools/check-game-contracts.cjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "benchmark": "node --experimental-vm-modules tools/benchmark-current.cjs",
    "benchmark:render": "node tools/benchmark-render.cjs",
    "stats": "node tools/run-stats.cjs",
    "admin:reset-password": "node tools/reset-password.cjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-utreys \"node tests/rules/firestore-rules.cjs\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
